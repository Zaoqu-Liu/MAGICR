# Makevars for MAGICR
# Cross-platform compatible settings for RcppArmadillo

CXX_STD = CXX11
PKG_CXXFLAGS = $(SHLIB_OPENMP_CXXFLAGS)
PKG_LIBS = $(SHLIB_OPENMP_CXXFLAGS) $(LAPACK_LIBS) $(BLAS_LIBS) $(FLIBS)

# Note: We do NOT enable OpenMP explicitly to avoid conflicts
# The package will work without parallel C++ code
# Parallelization is handled at the R level via the future package
