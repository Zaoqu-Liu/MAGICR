Package: MAGICR
Type: Package
Title: Markov Affinity-Based Graph Imputation of Cells
Version: 1.0.0
Date: 2026-01-26
Authors@R: c(
    person("Zaoqu", "Liu", email = "liuzaoqu@163.com", role = c("aut", "cre"),
           comment = c(ORCID = "0000-0002-0452-742X")),
